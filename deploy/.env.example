# Public host name. Without a domain, use the Elastic IP through sslip.io,
# for example 3.91.10.20 becomes 3-91-10-20.sslip.io.
WK_DOMAIN=

# Image to run. :latest is only for the first start; from then on the deploy
# workflow writes the tested commit's tag here (sha-<12 hex>).
WK_IMAGE=ghcr.io/donblack-117/watchkeeper:latest

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Dashboard account, created or updated at startup (password: 12 to 72 bytes).
WK_ADMIN_USER=
WK_ADMIN_PASSWORD=

# Optional bearer token for scripts (openssl rand -hex 32).
WK_API_TOKEN=

# Telegram alerts (docs/deploy.md, "Telegram"): bot token from @BotFather and
# the chat id. The observability profile requires them for Grafana's alerts.
WK_TELEGRAM_BOT_TOKEN=
WK_TELEGRAM_CHAT_ID=
# Also alert when a check is only degraded (slow or some failed runs).
WK_ALERT_ON_DEGRADED=false
# Dashboard link added to alerts, for example https://3-91-10-20.sslip.io
WK_PUBLIC_URL=

# Grafana at https://grafana.<WK_DOMAIN> (observability profile). Pick your own
# user name: "admin" is the first one anyone tries.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

WK_ALLOW_PRIVATE_TARGETS=false
WK_MAX_CONCURRENT=10
WK_MAX_CHECKS=200
WK_RETENTION_DAYS=90
WK_LOG_LEVEL=info
