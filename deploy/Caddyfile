# Caddy gets and renews the Let's Encrypt certificates by itself. It replaces
# any X-Forwarded-For sent by the client with the real address.
{$WK_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:8090
}

# Grafana from the observability profile, on its own origin: an XSS in Grafana
# cannot reach the dashboard's session. 502 while the profile is off.
grafana.{$WK_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy grafana:3000
}
