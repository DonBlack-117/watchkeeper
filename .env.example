# Listen address. Anything other than loopback requires WK_API_TOKEN.
WK_ADDR=127.0.0.1:8090
WK_DATABASE_URL=postgres://watchkeeper:watchkeeper@localhost:5432/watchkeeper?sslmode=disable
# Bearer token for every endpoint except /status and /health (at least 32 characters).
# Generate one with: openssl rand -hex 32
WK_API_TOKEN=
# Let checks reach localhost and private networks. Keep false on public servers.
WK_ALLOW_PRIVATE_TARGETS=false
WK_MAX_CONCURRENT=10
WK_MAX_CHECKS=200
WK_RELOAD_INTERVAL=30s
WK_RETENTION_DAYS=90
WK_LOG_LEVEL=info
