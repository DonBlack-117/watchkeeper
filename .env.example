# Listen address. Anything other than loopback requires WK_API_TOKEN.
WK_ADDR=127.0.0.1:8090
WK_DATABASE_URL=postgres://watchkeeper:watchkeeper@localhost:5432/watchkeeper?sslmode=disable
# Bearer token for scripts; every endpoint except /status, /health and login
# needs it or a dashboard session (at least 32 characters).
# Generate one with: openssl rand -hex 32
WK_API_TOKEN=
# Dashboard account, created or updated at startup (password: 12 to 72 bytes).
# Anything other than loopback needs this account or WK_API_TOKEN.
WK_ADMIN_USER=
WK_ADMIN_PASSWORD=
# Session cookie only over HTTPS. Defaults to true unless WK_ADDR is loopback.
WK_COOKIE_SECURE=
# Reverse proxies whose X-Forwarded-For is trusted for rate limits (CIDRs or IPs).
WK_TRUSTED_PROXIES=
# Let checks reach localhost and private networks. Keep false on public servers.
WK_ALLOW_PRIVATE_TARGETS=false
WK_MAX_CONCURRENT=10
WK_MAX_CHECKS=200
WK_RELOAD_INTERVAL=30s
WK_RETENTION_DAYS=90
WK_LOG_LEVEL=info
